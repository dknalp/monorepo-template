# API Service
API_PORT=8080
API_DB_URL=postgres://postgres:postgres@localhost:5432/api?sslmode=disable

# Auth Service
AUTH_PORT=8081
AUTH_DB_URL=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable
JWT_SECRET=your-secret-here

# Storage Service
STORAGE_PORT=8082
STORAGE_DB_URL=postgres://postgres:postgres@localhost:5432/storage?sslmode=disable

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
